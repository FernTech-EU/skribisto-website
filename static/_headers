#
# Response headers, read by Cloudflare Pages at deploy time.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The site runs no script and loads nothing from anyone else, so the policy can
# say exactly that. A JSON-LD block is data, not script, and is not affected.
# If the site ever needs a script or a third-party resource, this is the line
# that has to change, on purpose.

/*
  Content-Security-Policy: default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin

# Screenshots are written under a name that carries a hash of their content,
# so a changed image is a new URL and the old one can be kept for a year.
/processed_images/*
  Cache-Control: public, max-age=31536000, immutable

# The same site answers on the project's pages.dev address and on every preview
# deployment. Only www.skribisto.eu should be in a search engine.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
